{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myimageupscaler",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "myimageupscaler.com/*", "zone_name": "myimageupscaler.com" },
    { "pattern": "www.myimageupscaler.com/*", "zone_name": "myimageupscaler.com" }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "myimageupscaler-inc-cache"
    }
  ],
  "observability": {
    "enabled": true
  },
  "tail_consumers": [{ "service": "myimageupscaler-refund-tail" }],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "myimageupscaler"
    }
  ]
}
