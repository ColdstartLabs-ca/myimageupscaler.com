{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myimageupscaler-perf-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "myimageupscaler-perf-preview-cache" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] },
    { "tag": "v2-tag-cache", "new_sqlite_classes": ["DOShardedTagCache"] }
  ],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "myimageupscaler-perf-preview" }]
}
